  "appName": "BANKER",
  "webDir": "dist",
  "backgroundColor": "#000000",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#000000",
    "scheme": "BANKER",
    "limitsNavigationsToAppBoundDomains": false
