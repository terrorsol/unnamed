{
  "name": "unnamed-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "postinstall": "node -e \"const fs=require('fs');for(const d of ['@solana/wallet-adapter-react','@solana-mobile/mobile-wallet-adapter-protocol-web3js','@solana-mobile/wallet-standard-mobile']){try{fs.rmSync('node_modules/'+d+'/node_modules/@types',{recursive:true,force:true})}catch{}}\"",
    "backtest": "node --experimental-strip-types scripts/backtest.mjs",
    "replay": "node --experimental-strip-types scripts/replay.mjs"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.8",
    "@solana/wallet-adapter-backpack": "^0.1.14",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-phantom": "^0.9.24",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/wallet-adapter-solflare": "^0.6.28",
    "@solana/web3.js": "^1.95.3",
    "bs58": "^6.0.0",
    "lightweight-charts": "^4.2.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-node-polyfills": "^0.22.0"
  },
  "overrides": {
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom"
  }
}
